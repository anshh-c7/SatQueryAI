# Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only key required by the account deletion route. Never expose this as NEXT_PUBLIC_...
SUPABASE_SERVICE_ROLE_KEY=
# Older projects may show an anon key instead:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Existing backend proxy
BACKEND_URL=https://capacity-property-vegan.ngrok-free.dev
