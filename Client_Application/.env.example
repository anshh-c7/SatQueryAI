# Server-side authentication service. Leave empty to use the local mock endpoint.
AUTH_API_URL=

# Server-side ML/query service. Receives multipart/form-data with prompt and file.
# Leave empty to use the local mock response.
ML_QUERY_URL=

# Temporary server-console logging of query and uploaded-file metadata only.
DEBUG_REQUESTS=false

# Client-side dashboard integrations. Leave empty to use local mock behavior.
NEXT_PUBLIC_MIDDLEWARE_URL=
NEXT_PUBLIC_FASTAPI_INGEST_URL=